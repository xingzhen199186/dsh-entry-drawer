{
  "name": "dsh-entry-drawer",
  "version": "0.1.0",
  "type": "module",
  "description": "Folds the left sidebar's global panel entries behind one switch so session history keeps its room.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingzhen199186/dsh-entry-drawer.git"
  },
  "homepage": "https://github.com/xingzhen199186/dsh-entry-drawer",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "sidebar",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
